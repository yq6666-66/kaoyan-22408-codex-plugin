{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavior evaluation judge output",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "primarySkillPassed", "criteria", "summary"],
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "primarySkillPassed": {
      "type": "boolean"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "passed", "evidence"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
