{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yq6666-66/kaoyan-22408-codex-plugin/blob/main/plugins/kaoyan-22408/references/portable-learning-records.schema.json",
  "title": "Kaoyan 22408 portable learning records",
  "description": "The root validates Schema 1.1 outputs. Schema 1.0 inputs are available at #/$defs/legacyInput.",
  "oneOf": [
    { "$ref": "#/$defs/studyProfile11" },
    { "$ref": "#/$defs/progressSnapshot11" },
    { "$ref": "#/$defs/reviewQueue11" }
  ],
  "$defs": {
    "legacyInput": {
      "anyOf": [
        { "$ref": "#/$defs/studyProfile10" },
        { "$ref": "#/$defs/progressSnapshot10" },
        { "$ref": "#/$defs/reviewQueue10" }
      ]
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": { "enum": ["未提供", "unknown"] }
    },
    "nullableString": {
      "anyOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "null" }
      ]
    },
    "legacyNullableString": { "type": ["string", "null"] },
    "legacyNullableDate": {
      "anyOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
        { "enum": [null, "", "未提供", "unknown"] }
      ]
    },
    "legacyNullableNumber": {
      "anyOf": [
        { "type": "number", "minimum": 0 },
        { "enum": [null, "", "未提供", "unknown"] }
      ]
    },
    "legacyNullableInteger": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "enum": [null, "", "未提供", "unknown"] }
      ]
    },
    "legacyNullableRate": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "enum": [null, "", "未提供", "unknown"] }
      ]
    },
    "legacyStringArray": {
      "anyOf": [
        { "type": "array", "items": { "type": "string" } },
        { "enum": [null, "", "未提供", "unknown"] }
      ]
    },
    "nullableDate": {
      "anyOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
        { "type": "null" }
      ]
    },
    "studyProfile11": {
      "type": "object",
      "required": ["schemaVersion", "recordType", "targetExam", "targetDate", "weeklyHours", "currentPhase", "constraints"],
      "properties": {
        "schemaVersion": { "const": "1.1" },
        "recordType": { "const": "StudyProfile" },
        "targetExam": { "$ref": "#/$defs/nullableString" },
        "targetDate": { "$ref": "#/$defs/nullableDate" },
        "weeklyHours": { "type": ["number", "null"], "minimum": 0 },
        "currentPhase": { "$ref": "#/$defs/nullableString" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "redactedFields": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
        "legacyExtensions": { "type": "object", "additionalProperties": true },
        "migrationWarnings": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      },
      "additionalProperties": true
    },
    "metric11": {
      "type": "object",
      "required": ["subject", "name", "unit", "planned", "completed"],
      "properties": {
        "subject": { "$ref": "#/$defs/nullableString" },
        "name": { "$ref": "#/$defs/nullableString" },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "planned": { "type": ["number", "null"], "minimum": 0 },
        "completed": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "accuracy11": {
      "type": "object",
      "required": ["subject", "correct", "total", "rate"],
      "properties": {
        "subject": { "$ref": "#/$defs/nullableString" },
        "correct": { "type": ["integer", "null"], "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 },
        "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "total": { "const": 0 } }, "required": ["total"] },
          "then": {
            "properties": {
              "correct": { "enum": [0, null] },
              "rate": { "type": "null" }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "progressSnapshot11": {
      "type": "object",
      "required": ["schemaVersion", "recordType", "period", "metrics", "accuracy", "blockers"],
      "properties": {
        "schemaVersion": { "const": "1.1" },
        "recordType": { "const": "ProgressSnapshot" },
        "period": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/nullableDate" },
            "end": { "$ref": "#/$defs/nullableDate" }
          },
          "additionalProperties": true
        },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric11" } },
        "accuracy": { "type": "array", "items": { "$ref": "#/$defs/accuracy11" } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "redactedFields": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
        "legacyExtensions": { "type": "object", "additionalProperties": true },
        "migrationWarnings": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      },
      "additionalProperties": true
    },
    "reviewItem11": {
      "type": "object",
      "required": ["subject", "topic", "errorCause", "errorCauseStatus", "nextRetestDate", "retestOffsetDays", "status", "masteryEvidence"],
      "properties": {
        "subject": { "$ref": "#/$defs/nullableString" },
        "topic": { "$ref": "#/$defs/nullableString" },
        "errorCause": { "$ref": "#/$defs/nullableString" },
        "errorCauseStatus": { "enum": ["confirmed", "hypothesis", null] },
        "nextRetestDate": { "$ref": "#/$defs/nullableDate" },
        "retestOffsetDays": { "type": ["integer", "null"], "minimum": 0 },
        "status": { "enum": ["pending", "due", "retesting", "mastered", null] },
        "masteryEvidence": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      },
      "not": {
        "required": ["nextRetestDate", "retestOffsetDays"],
        "properties": {
          "nextRetestDate": { "type": "string" },
          "retestOffsetDays": { "type": "integer" }
        }
      },
      "additionalProperties": true
    },
    "reviewQueue11": {
      "type": "object",
      "required": ["schemaVersion", "recordType", "generatedAt", "items"],
      "properties": {
        "schemaVersion": { "const": "1.1" },
        "recordType": { "const": "ReviewQueue" },
        "generatedAt": { "$ref": "#/$defs/nullableDate" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/reviewItem11" } },
        "redactedFields": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
        "legacyExtensions": { "type": "object", "additionalProperties": true },
        "migrationWarnings": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      },
      "additionalProperties": true
    },
    "studyProfile10": {
      "type": "object",
      "required": ["schemaVersion", "targetExam"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "targetExam": { "$ref": "#/$defs/legacyNullableString" },
        "targetDate": { "$ref": "#/$defs/legacyNullableDate" },
        "weeklyHours": { "$ref": "#/$defs/legacyNullableNumber" },
        "currentPhase": { "$ref": "#/$defs/legacyNullableString" },
        "constraints": { "$ref": "#/$defs/legacyStringArray" }
      },
      "additionalProperties": true
    },
    "legacySubject10": {
      "type": "object",
      "properties": {
        "subject": { "$ref": "#/$defs/legacyNullableString" },
        "plannedUnits": { "$ref": "#/$defs/legacyNullableNumber" },
        "completedUnits": { "$ref": "#/$defs/legacyNullableNumber" },
        "accuracy": { "$ref": "#/$defs/legacyNullableRate" },
        "sampleSize": { "$ref": "#/$defs/legacyNullableInteger" }
      },
      "additionalProperties": true
    },
    "progressSnapshot10": {
      "type": "object",
      "required": ["schemaVersion"],
      "anyOf": [
        { "required": ["period"] },
        { "required": ["plannedUnits"] },
        { "required": ["completedUnits"] },
        { "required": ["accuracy"] },
        { "required": ["sampleSize"] },
        { "required": ["bySubject"] },
        { "required": ["blockers"] }
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "period": {
          "type": "object",
          "properties": {
            "start": { "$ref": "#/$defs/legacyNullableDate" },
            "end": { "$ref": "#/$defs/legacyNullableDate" }
          },
          "additionalProperties": true
        },
        "plannedUnits": { "$ref": "#/$defs/legacyNullableNumber" },
        "completedUnits": { "$ref": "#/$defs/legacyNullableNumber" },
        "accuracy": { "$ref": "#/$defs/legacyNullableRate" },
        "sampleSize": { "$ref": "#/$defs/legacyNullableInteger" },
        "bySubject": { "type": "array", "items": { "$ref": "#/$defs/legacySubject10" } },
        "blockers": { "$ref": "#/$defs/legacyStringArray" }
      },
      "additionalProperties": true
    },
    "legacyReviewItem10": {
      "type": "object",
      "properties": {
        "subject": { "$ref": "#/$defs/legacyNullableString" },
        "topic": { "$ref": "#/$defs/legacyNullableString" },
        "errorCause": { "$ref": "#/$defs/legacyNullableString" },
        "retestDate": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "masteryEvidence": { "$ref": "#/$defs/legacyStringArray" }
      },
      "additionalProperties": true
    },
    "reviewQueue10": {
      "type": "object",
      "required": ["schemaVersion", "items"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "generatedAt": { "$ref": "#/$defs/legacyNullableDate" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/legacyReviewItem10" } }
      },
      "additionalProperties": true
    }
  }
}
