{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yq6666-66/kaoyan-22408-codex-plugin/blob/main/plugins/kaoyan-408/references/past-paper-knowledge.schema.json",
  "title": "408考研插件真题知识记录",
  "oneOf": [
    { "$ref": "#/$defs/PastPaperSource" },
    { "$ref": "#/$defs/PastPaperQuestion" },
    { "$ref": "#/$defs/PastPaperAnalysis" }
  ],
  "$defs": {
    "subject": {
      "type": "string",
      "enum": ["数学一", "数学二", "英语一", "英语二", "408"]
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "PastPaperSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "recordType", "sourceId", "subject", "paperYear", "examDate", "paperType", "sourceUrl", "sourceKind", "publisher", "repository", "filePath", "commit", "license", "retrievedAt", "contentSha256", "completeness", "verificationStatus", "storagePolicy"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "recordType": { "const": "PastPaperSource" },
        "sourceId": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/$defs/subject" },
        "paperYear": { "type": "integer", "minimum": 2010, "maximum": 2026 },
        "examDate": { "type": ["string", "null"], "format": "date" },
        "paperType": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sourceKind": { "enum": ["official", "github", "web"] },
        "publisher": { "$ref": "#/$defs/nullableString" },
        "repository": { "$ref": "#/$defs/nullableString" },
        "filePath": { "$ref": "#/$defs/nullableString" },
        "commit": { "$ref": "#/$defs/nullableString" },
        "license": { "$ref": "#/$defs/nullableString" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "contentSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "completeness": { "enum": ["complete", "partial", "unknown"] },
        "verificationStatus": { "enum": ["verified", "conflict", "pending"] },
        "storagePolicy": { "enum": ["full-text", "index-only"] }
      }
    },
    "PastPaperQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "recordType", "questionId", "sourceId", "subject", "paperYear", "paperType", "questionNumber", "module", "knowledgePoints", "score", "promptExcerpt", "visualRefs", "answerProvenance", "dedupeKey"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "recordType": { "const": "PastPaperQuestion" },
        "questionId": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/$defs/subject" },
        "paperYear": { "type": "integer", "minimum": 2010, "maximum": 2026 },
        "paperType": { "type": "string", "minLength": 1 },
        "questionNumber": { "type": "string", "minLength": 1 },
        "module": { "$ref": "#/$defs/nullableString" },
        "knowledgePoints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "score": { "type": ["number", "null"], "minimum": 0 },
        "promptExcerpt": { "$ref": "#/$defs/nullableString" },
        "visualRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "answerProvenance": { "enum": ["official", "third-party", "user", "model", "unknown"] },
        "dedupeKey": { "type": "string", "minLength": 1 }
      }
    },
    "PastPaperAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "recordType", "analysisId", "questionId", "analysisKind", "prerequisites", "steps", "method", "independentCheck", "commonErrors", "transferExercise", "diagramSource", "confidence", "generatedAt"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "recordType": { "const": "PastPaperAnalysis" },
        "analysisId": { "type": "string", "minLength": 1 },
        "questionId": { "type": "string", "minLength": 1 },
        "analysisKind": { "const": "original" },
        "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "method": { "type": "string", "minLength": 1 },
        "independentCheck": { "type": "string", "minLength": 1 },
        "commonErrors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "transferExercise": { "$ref": "#/$defs/nullableString" },
        "diagramSource": { "$ref": "#/$defs/nullableString" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
